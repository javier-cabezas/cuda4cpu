@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenMP COMPONENTS CXX)

include("${CMAKE_CURRENT_LIST_DIR}/cuda4cpu-targets.cmake")

set_property(GLOBAL PROPERTY CUDA4CPU_REWRITE "@PACKAGE_CMAKE_INSTALL_BINDIR@/cuda4cpu-rewrite")
include("${CMAKE_CURRENT_LIST_DIR}/cuda4cpu-cuda.cmake")

check_required_components(cuda4cpu)
