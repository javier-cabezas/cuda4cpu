"""A C++ compiler driver that compiles CUDA and HIP source files with cuda4cpu.

Use it like the C++ compiler, with .cu or .hip files among the inputs:

    cuda4cpu-c++ -O2 -o app main.cpp kernels.cu

Each .cu file is rewritten by cuda4cpu-rewrite and compiled as C++ with
cuda_runtime.h included implicitly, as nvcc does. .hip files are rewritten
as HIP sources, and also get cuda_runtime.h, which has the kernel language:
they include hip/hip_runtime.h themselves, as they do with hipcc, after
macros such as HIP_TEMPLATE_KERNEL_LAUNCH that configure it. -x cu and
-x hip choose the language of the files that follow them, as with clang.

Installed as cuda4cpu-hipcc, it treats every C++ source file as a HIP
source, as hipcc does, and drops hipcc's options for AMD GPUs
(--offload-arch=..., -fgpu-rdc, ...). --emit-static-lib compiles the sources
into a static library, as hipcc does. As hipcc, it answers --version, adds
HIPCC_COMPILE_FLAGS_APPEND (and HIPCC_LINK_FLAGS_APPEND when it links), and
shows its commands with HIPCC_VERBOSE=1.

Installed as cuda4cpu-nvcc, it takes nvcc's command line, so that build
scripts written for nvcc work unchanged: options for the GPU and for nvcc's
own steps are dropped, nvcc's names of the host compiler's options are
translated (-Xcompiler, -ccbin, --compiler-options, -dc, ...), and
--version, -v and --dryrun answer as nvcc does. It defines __NVCC__ and
__CUDACC_VER_MAJOR__, __CUDACC_VER_MINOR__ and __CUDACC_VER_BUILD__, and
reads NVCC_PREPEND_FLAGS and NVCC_APPEND_FLAGS.

cuda4cpu's headers need C++23, so the drivers raise an older -std (c++17,
gnu++20, ...) to it, of the same dialect: a build system that asks for
C++17 still compiles, and host code that includes cuda_runtime.h too.

The driver adds the C++ standard, OpenMP and the cuda4cpu include directory,
and links libcuda4cpu when it links. The compiler is $CUDA4CPU_CXX, $CXX
(unless it is a cuda4cpu driver, as in CXX=cuda4cpu-c++ make), the compiler
that built libcuda4cpu, or c++.
"""

import os
import shlex
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
INCLUDE_DIR = os.path.normpath(os.path.join(HERE, '@CUDA4CPU_DRIVER_INCLUDE_DIR@'))
LIBRARY_DIR = os.path.normpath(os.path.join(HERE, '@CUDA4CPU_DRIVER_LIBRARY_DIR@'))
REWRITE = os.path.normpath(os.path.join(HERE, '@CUDA4CPU_DRIVER_REWRITE@'))
# The directory laid out like a CUDA toolkit (cmake/cuda4cpu-toolkit.cmake)
TOOLKIT = os.path.normpath(os.path.join(HERE, '@CUDA4CPU_DRIVER_TOOLKIT_DIR@'))
# cuda4cpu-c++, which cuda4cpu-nvcc links with, as nvcc with its host compiler
HOST_DRIVER = os.path.join(HERE, 'cuda4cpu-c++')

# 'hip' for cuda4cpu-hipcc, which compiles C++ sources as HIP, as hipcc does,
# and 'nvcc' for cuda4cpu-nvcc, which takes nvcc's options
MODE = '@CUDA4CPU_DRIVER_MODE@'
VERSION = '@PROJECT_VERSION@'

# The compiler that built libcuda4cpu. Another one would link its own OpenMP
# runtime: with GCC's libgomp next to Clang's libomp, a process has two pools
# of OpenMP threads.
LIBRARY_CXX = '@CUDA4CPU_DRIVER_CXX@'

# Compiler options whose value is the next argument
OPTIONS_WITH_VALUE = {
    '-o', '-x', '-include', '-imacros', '-isystem', '-iquote', '-idirafter', '-iprefix',
    '-iwithprefix', '-iwithprefixbefore', '-isysroot', '-MF', '-MT', '-MQ', '-Xlinker',
    '-Xassembler', '-Xpreprocessor', '-L', '-I', '-D', '-U', '-l', '-T', '-u', '-e',
    '-aux-info', '--param', '-dumpbase', '-dumpdir', '-wrapper', '-z',
}

# Options that stop before linking
NO_LINK = {'-c', '-S', '-E', '-M', '-MM', '-fsyntax-only'}

# Languages of -x, and the extensions of each language's files
LANGUAGES = ('cuda', 'hip')
X_LANGUAGES = {'cu': 'cuda', 'cuda': 'cuda', 'hip': 'hip'}
EXTENSIONS = {'.cu': 'cuda', '.hip': 'hip'}
CXX_EXTENSIONS = ('.cpp', '.cc', '.cxx', '.c++', '.cp', '.CPP', '.C', '.cu', '.hip')

# hipcc's options for AMD GPUs, which cuda4cpu-hipcc drops: those that start
# with one of these prefixes, and the macros that select HIP's AMD platform
HIPCC_DROPPED_PREFIXES = ('--offload-arch=', '--amdgpu-target=', '--cuda-gpu-arch=', '--rocm-path=',
                          '--hip-path=', '--hip-device-lib', '--rocm-device-lib-path=', '-fgpu-', '-fno-gpu-',
                          '-mcode-object-version=', '-munsafe-fp-atomics', '-mno-unsafe-fp-atomics',
                          '-mwavefrontsize64', '-mno-wavefrontsize64', '-mcumode', '-mno-cumode')
HIPCC_DROPPED = {'--hip-link', '--offload-device-only', '--offload-host-only', '-fhip-new-launch-api',
                 '-D__HIP_PLATFORM_AMD__', '-D__HIP_PLATFORM_AMD__=1', '-D__HIP_PLATFORM_HCC__',
                 '-D__HIP_PLATFORM_HCC__=1'}


#
# nvcc's command line. Each option has a name of its own and nvcc's short
# one, either spelled with one dash or two, and its value inline (=value) or
# in the next argument. NVCC_OPTIONS maps the names to what cuda4cpu-nvcc
# does with them.
#

# The version of CUDA that cuda4cpu implements (CUDART_VERSION), as nvcc's
NVCC_VERSION = (12, 0, 140)

# The architecture nvcc 12.0 compiles for by default, which -v reports
NVCC_DEFAULT_ARCHITECTURE = 52

DROP, DROP_VALUE = 'drop', 'drop value'

NVCC_OPTIONS = {
    # The GPU and its code, and nvcc's steps that make it: nothing to do on
    # the CPU
    **dict.fromkeys(['arch', 'gpu-architecture', 'code', 'gpu-code', 'gencode', 'generate-code',
                     'Xptxas', 'ptxas-options', 'Xnvlink', 'nvlink-options', 'Xfatbin', 'fatbin-options',
                     'Xcudafe', 'Xarchive', 'archive-options', 'maxrregcount', 't', 'threads', 'split-compile',
                     'keep-dir', 'odir', 'output-directory', 'cudart', 'cudadevrt', 'default-stream',
                     'diag-suppress', 'diag-warn', 'diag-error', 'ftz', 'prec-div', 'prec-sqrt', 'fmad',
                     'dopt', 'Ofast-compile', 'rdc', 'relocatable-device-code', 'machine', 'm',
                     'ewp', 'extensible-whole-program', 'Xnvvm', 'nvvm-options', 'Xnvlink'], DROP_VALUE),
    **dict.fromkeys(['expt-relaxed-constexpr', 'expt-extended-lambda', 'extended-lambda', 'use_fast_math',
                     'use-fast-math', 'lineinfo', 'generate-line-info', 'res-usage', 'resource-usage', 'keep',
                     'src-in-ptx', 'source-in-ptx', 'restrict', 'forward-unknown-to-host-compiler',
                     'forward-unknown-opts', 'forward-unknown-to-host-linker', 'Wno-deprecated-gpu-targets',
                     'Wext-lambda-captures-this', 'Wdefault-stream-launch', 'Wmissing-launch-bounds',
                     'display-error-number', 'no-display-error-number', 'noprof', 'no-host-device-initializer-list',
                     'no-host-device-move-forward', 'allow-unsupported-compiler', 'static-global-template-stub',
                     'qpp-config'], DROP),
    # nvcc's names of the host compiler's options
    'include-path': ['-I'], 'library-path': ['-L'], 'library': ['-l'], 'define-macro': ['-D'],
    'undefine-macro': ['-U'], 'output-file': ['-o'], 'pre-include': ['-include'], 'system-include': ['-isystem'],
    'dependency-output': ['-MF'], 'dependency-target-name': ['-MT'], 'optimize': ['-O'],
    'compile': '-c', 'device-c': '-c', 'dc': '-c', 'device-w': '-c', 'dw': '-c', 'preprocess': '-E',
    'debug': '-g', 'device-debug': '-g', 'G': '-g', 'shared': '-shared',
    'generate-dependencies': '-M', 'generate-nonsystem-dependencies': '-MM',
    'generate-dependencies-with-compile': '-MD', 'generate-nonsystem-dependencies-with-compile': '-MMD',
    'x': ['-x'], 'language': ['-x'],
    # Handled by translate_nvcc
    **dict.fromkeys(['Xcompiler', 'compiler-options', 'Xlinker', 'linker-options', 'ccbin', 'compiler-bindir',
                     'std', 'Werror', 'options-file', 'optf'], 'special value'),
    **dict.fromkeys(['dlink', 'device-link', 'lib', 'cuda', 'version', 'V', 'v', 'verbose', 'dryrun', 'dry-run',
                     'help', 'h', 'ptx', 'cubin', 'fatbin', 'optix-ir', 'ltoir'], 'special'),
}

# Libraries that libcuda4cpu provides
NVCC_PROVIDED_LIBRARIES = {'cudart', 'cudart_static', 'cuda', 'cudadevrt', 'nvToolsExt', 'nvtx3interop'}

# nvcc's warning kinds, the value of its -Werror
NVCC_WARNING_KINDS = {'cross-execution-space-call', 'reorder', 'default-stream-launch', 'missing-launch-bounds',
                      'ext-lambda-captures-this', 'deprecated-declarations'}


# HIP's version (include/hip/hip_version.h), as hipcc --version reports it
HIP_VERSION = '7.2.0'


class NvccRequest:
    """What an nvcc (or hipcc) command line asks for, besides the host
    compiler's options"""

    def __init__(self):
        self.host_compiler = None       # from -ccbin
        self.step = None                # 'version', 'help', 'dlink' or 'lib', or None for a compile or link
        self.verbose = False            # -v: show the commands
        self.dry_run = False            # --dryrun: only show them


def nvcc_name(arg):
    """The name and inline value of arg if it's one of NVCC_OPTIONS, spelled
    with one or two dashes; else (None, None)"""
    if not arg.startswith('-') or arg == '-':
        return None, None
    body = arg[2:] if arg.startswith('--') else arg[1:]
    name, equals, value = body.partition('=')
    if name in NVCC_OPTIONS:
        return name, (value if equals else None)
    return None, None


def host_compiler_for(ccbin):
    """The C++ compiler that -ccbin names: a directory that holds one, or a C
    or C++ compiler, whose C++ counterpart is used (gcc-14 gives g++-14)"""
    if os.path.isdir(ccbin):
        for name in ('g++', 'clang++', 'c++'):
            if os.path.exists(os.path.join(ccbin, name)):
                return os.path.join(ccbin, name)
        return ccbin
    directory, name = os.path.split(ccbin)
    for c, cxx in (('gcc', 'g++'), ('clang', 'clang++'), ('cc', 'c++')):
        if name == c or name.startswith(c + '-'):
            return os.path.join(directory, cxx + name[len(c):])
    return ccbin


def raise_standard(arg):
    """-std=X raised to C++23 if X is an older C++ standard, in the same
    dialect (c++ or gnu++)"""
    value = arg[len('-std='):]
    for dialect in ('c++', 'gnu++'):
        if value.startswith(dialect) and value[len(dialect):] in ('98', '03', '0x', '11', '1y', '14', '1z', '17',
                                                                  '2a', '20'):
            return '-std=' + dialect + '23'
    return arg


def translate_nvcc(argv):
    """nvcc's command line as the host compiler's, and what else it asks for"""
    argv = (shlex.split(os.environ.get('NVCC_PREPEND_FLAGS', '')) + argv +
            shlex.split(os.environ.get('NVCC_APPEND_FLAGS', '')))
    request = NvccRequest()
    args = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        name, value = nvcc_name(arg)
        action = NVCC_OPTIONS.get(name)
        takes_value = action in (DROP_VALUE, 'special value') or isinstance(action, list)
        if takes_value and value is None and name != 'Werror':
            if i + 1 >= len(argv):
                args.append(arg)
                break
            value = argv[i + 1]
            i += 1
        i += 1
        if name is None:
            if arg == '-l' and i < len(argv):                     # -l name
                if argv[i] not in NVCC_PROVIDED_LIBRARIES:
                    args += [arg, argv[i]]
                i += 1
            elif arg.startswith('-l') and arg[2:] in NVCC_PROVIDED_LIBRARIES:
                pass
            elif arg.startswith('-std='):
                args.append(raise_standard(arg))
            elif arg.endswith('.c') and not arg.startswith('-'):
                args += ['-x', 'c', arg, '-x', 'none']          # host C, as nvcc compiles it
            else:
                args.append(arg)
        elif action in (DROP, DROP_VALUE):
            pass
        elif isinstance(action, list):                          # an option of the host compiler, with a value
            if action == ['-l'] and value in NVCC_PROVIDED_LIBRARIES:
                continue
            args += ['-O' + value] if action == ['-O'] else action + [value]
        elif action != 'special' and action != 'special value':
            args.append(action)                                 # one without a value
        elif name in ('Xcompiler', 'compiler-options'):
            # A comma-separated list, of which each item may hold several
            # options separated by spaces
            for item in value.split(','):
                args += shlex.split(item)
        elif name in ('Xlinker', 'linker-options'):
            args += ['-Wl,' + item for item in value.split(',') if item]
        elif name in ('ccbin', 'compiler-bindir'):
            request.host_compiler = host_compiler_for(value)
        elif name in ('options-file', 'optf'):
            # More options, from files, as CMake passes long command lines
            for path in value.split(','):
                with open(path) as f:
                    argv[i:i] = shlex.split(f.read())
        elif name == 'std':
            args.append(raise_standard('-std=' + value))
        elif name == 'Werror':
            # nvcc's -Werror takes kinds of warnings; all-warnings is the host
            # compiler's -Werror
            if value is None and i < len(argv) and set(argv[i].split(',')) <= NVCC_WARNING_KINDS | {'all-warnings'}:
                value = argv[i]
                i += 1
            if value is None or 'all-warnings' in value.split(','):
                args.append('-Werror')
        elif name in ('version', 'V'):
            request.step = 'version'
        elif name in ('help', 'h'):
            request.step = 'help'
        elif name in ('dlink', 'device-link'):
            request.step = 'dlink'
        elif name == 'lib':
            request.step = 'lib'
        elif name == 'cuda':
            request.step = 'cuda'
        elif name in ('ptx', 'cubin', 'fatbin', 'optix-ir', 'ltoir'):
            request.step = 'gpu ' + name
        elif name in ('v', 'verbose'):
            request.verbose = True
        elif name in ('dryrun', 'dry-run'):
            request.dry_run = True
    return args, request


def nvcc_version(compiler):
    major, minor, build = NVCC_VERSION
    return (f'nvcc: cuda4cpu Cuda compiler driver\n'
            f'cuda4cpu {VERSION}, which compiles CUDA for the CPU with {compiler}\n'
            f'Cuda compilation tools, release {major}.{minor}, V{major}.{minor}.{build}\n'
            f'Build cuda4cpu_{VERSION}\n')


NVCC_HELP = """Usage: cuda4cpu-nvcc [options] <inputs>

cuda4cpu-nvcc compiles CUDA for the CPU, and takes nvcc's options. Options for
the GPU (-arch, -gencode, -Xptxas, --expt-relaxed-constexpr, ...) are
accepted and ignored. nvcc's names for the host compiler's options
(--compiler-options, -Xcompiler, -ccbin, -dc, --include-path, ...) are
translated, and any other option goes to the host compiler as it is.
"""


def source_language(path, x_language):
    """The language of an input file: 'cuda', 'hip', or None for other files."""
    if path.startswith('-'):
        return None
    if x_language is not None:
        return x_language if x_language in LANGUAGES else None
    if MODE == 'hip' and path.endswith(CXX_EXTENSIONS):
        return 'hip'
    return EXTENSIONS.get(os.path.splitext(path)[1])


def work_directory(argv):
    """Where the rewritten sources go: next to the output file when there is
    one, so that their paths, which reach the compiler's command line and
    preprocessed output, are the same on every build and compiler caches such
    as ccache hit; a temporary directory otherwise."""
    for i, arg in enumerate(argv):
        output = argv[i + 1] if arg == '-o' and i + 1 < len(argv) else arg[2:] if arg.startswith('-o') and len(arg) > 2 else None
        if output:
            work = os.path.abspath(output) + '.cuda4cpu-src'
            shutil.rmtree(work, ignore_errors=True)
            os.makedirs(work)
            return work
    return tempfile.mkdtemp(prefix='cuda4cpu-')


def is_driver(command):
    """Whether command runs a cuda4cpu driver, which would then run itself"""
    path = shutil.which(command)
    if path is None:
        return False
    path = os.path.realpath(path)
    return os.path.dirname(path) == HERE and os.path.basename(path).startswith('cuda4cpu-')


def find_compiler(host_compiler=None):
    if os.environ.get('CUDA4CPU_CXX'):
        return os.environ['CUDA4CPU_CXX']
    if host_compiler:
        return host_compiler
    cxx = os.environ.get('CXX')
    if cxx and not is_driver(cxx):
        return cxx
    if LIBRARY_CXX and shutil.which(LIBRARY_CXX):
        return LIBRARY_CXX
    return 'c++'


# Set for the compiler the driver runs: a driver that finds it was run by
# one, through a compiler variable that names a driver in another way, stops
# instead of running itself until the machine runs out of memory
RUNNING = 'CUDA4CPU_DRIVER_RUNNING'


def nvcc_echo(command):
    """command as nvcc shows it, with its -I and -L options in double quotes,
    as CMake expects to find nvcc's INCLUDES and LIBRARIES in it"""
    return ' '.join(f'"{a}"' if a.startswith(('-I', '-L')) else shlex.quote(a) for a in command)


def nvcc_environment():
    """What nvcc -v shows before its commands: the variables of its
    configuration, from which CMake learns the toolkit's root, include and
    library directories, and the default architecture"""
    lines = [f'_NVVM_BRANCH_=nvvm', f'_HERE_={os.path.join(TOOLKIT, "bin")}', f'TOP={TOOLKIT}',
             f'NVVMIR_LIBRARY_DIR={os.path.join(TOOLKIT, "nvvm", "libdevice")}',
             f'PATH={os.path.join(TOOLKIT, "bin")}:{os.environ.get("PATH", "")}',
             f'INCLUDES="-I{os.path.join(TOOLKIT, "include")}"', 'SYSTEM_INCLUDES=',
             f'LIBRARIES=  "-L{os.path.join(TOOLKIT, "lib64")}"',
             f'_CUDA4CPU_ARCHITECTURE_=-arch compute_{NVCC_DEFAULT_ARCHITECTURE}']
    return ''.join('#$ ' + line + '\n' for line in lines)


def run(command, request, env=None):
    """Runs command, or with nvcc's -v or --dryrun (hipcc's HIPCC_VERBOSE)
    shows it first, or only"""
    if request is not None and (request.verbose or request.dry_run):
        sys.stderr.write(('hipcc-cmd: ' if MODE == 'hip' else '#$ ') + nvcc_echo(command) + '\n')
        if request.dry_run:
            return 0
    return subprocess.call(command, env=env)


def output_of(args, default):
    for i, arg in enumerate(args):
        if arg == '-o' and i + 1 < len(args):
            return args[i + 1]
        if arg.startswith('-o') and len(arg) > 2:
            return arg[2:]
    return default


def nvcc_device_link(compiler, args, request):
    """nvcc -dlink links the device code of relocatable objects into one
    more object. The CPU has no device code, so that object is empty."""
    command = [compiler, '-x', 'c++', '-c', os.devnull, '-o', output_of(args, 'a_dlink.o')]
    return run(command + [a for a in args if a in ('-fPIC', '-fpic', '-fPIE', '-fpie')], request)


def nvcc_library(args, request):
    """nvcc -lib archives objects into a static library"""
    sources = [a for a in args if not a.startswith('-') and source_language(a, None) is not None]
    if sources:
        sys.stderr.write('cuda4cpu-nvcc: -lib archives object files; compile ' + ' '.join(sources) +
                         ' with -c first\n')
        return 1
    output = output_of(args, 'a.a')
    objects = [a for a in args if a.endswith(('.o', '.obj', '.a')) and a != output]
    return run([os.environ.get('AR', 'ar'), 'rcs', output] + objects, request)


def hipcc_static_library(argv, request):
    """hipcc --emit-static-lib: compiles each source, and archives the
    objects (and any objects given) as the output"""
    argv = [a for a in argv if a != '--emit-static-lib']
    output = output_of(argv, 'a.out')
    sources, options, objects = [], [], []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == '-o':
            i += 2
            continue
        if arg.startswith('-o') and len(arg) > 2:
            pass
        elif arg in OPTIONS_WITH_VALUE and i + 1 < len(argv):
            options += [arg, argv[i + 1]]
            i += 2
            continue
        elif arg.endswith(('.o', '.obj', '.a')):
            objects.append(arg)
        elif not arg.startswith('-') and source_language(arg, None) is not None:
            sources.append(arg)
        else:
            options.append(arg)
        i += 1
    work = tempfile.mkdtemp(prefix='cuda4cpu-lib-')
    try:
        for n, source in enumerate(sources):
            obj = os.path.join(work, f'{n}-{os.path.basename(source)}.o')
            status = main(options + ['-c', source, '-o', obj])
            if status != 0:
                return status
            objects.append(obj)
        if os.path.exists(output):
            os.remove(output)
        return run([os.environ.get('AR', 'ar'), 'rcs', output] + objects, request)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def main(argv):
    if os.environ.get(RUNNING):
        sys.stderr.write(f'{os.path.basename(sys.argv[0])}: run as the compiler of a cuda4cpu driver; '
                         'set CUDA4CPU_CXX to a C++ compiler\n')
        return 1
    request = None
    if MODE == 'nvcc':
        argv, request = translate_nvcc(argv)
        if request.verbose or request.dry_run:
            sys.stderr.write(nvcc_environment())
        if request.step == 'version':
            sys.stdout.write(nvcc_version(find_compiler(request.host_compiler)))
            return 0
        if request.step == 'help':
            sys.stdout.write(NVCC_HELP)
            return 0
    if MODE == 'hip':
        request = NvccRequest()
        request.verbose = (int(os.environ.get('HIPCC_VERBOSE') or '0', 0) & 1) != 0
        if '--version' in argv:
            sys.stdout.write(f'HIP version: {HIP_VERSION}-cuda4cpu-{VERSION}\n')
            sys.stdout.flush()
            return subprocess.call([find_compiler(), '--version'], env=dict(os.environ, **{RUNNING: '1'}))
        if '--emit-static-lib' in argv:
            return hipcc_static_library(argv, request)
        argv = argv + shlex.split(os.environ.get('HIPCC_COMPILE_FLAGS_APPEND', ''))
        if not NO_LINK.intersection(argv):
            argv = argv + shlex.split(os.environ.get('HIPCC_LINK_FLAGS_APPEND', ''))
    compiler = find_compiler(request.host_compiler if request else None)
    if request is not None and request.step == 'dlink':
        return nvcc_device_link(compiler, argv, request)
    if request is not None and request.step == 'lib':
        return nvcc_library(argv, request)
    if request is not None and request.step and request.step.startswith('gpu '):
        sys.stderr.write(f'cuda4cpu-nvcc: -{request.step[4:]} makes GPU code, which runs on no CPU; cuda4cpu '
                         'compiles kernels with the host code\n')
        return 1
    if request is not None and request.step == 'cuda':
        # nvcc -cuda writes the host code of each .cu file to <file>.cpp.ii:
        # here, the rewritten file preprocessed
        sources = [a for a in argv if not a.startswith('-') and source_language(a, None) is not None]
        argv = argv + ['-E'] + ([] if '-o' in argv or len(sources) != 1 else ['-o', os.path.basename(sources[0]) + '.cpp.ii'])
    # Made for the first source that needs rewriting: a link through
    # cuda4cpu-c++ by cuda4cpu-nvcc must leave the sources it rewrote in the
    # same directory alone
    work = None
    try:
        args = []
        rewritten = False
        x_language = None                   # set by -x: a language, 'other', or None (by extension)
        i = 0
        while i < len(argv):
            arg = argv[i]
            if MODE == 'hip' and (arg in HIPCC_DROPPED or arg.startswith(HIPCC_DROPPED_PREFIXES)):
                i += 1
                continue
            if arg.startswith('-std='):
                arg = raise_standard(arg)
            if arg == '-x' and i + 1 < len(argv) or arg.startswith('-x') and len(arg) > 2:
                value = argv[i + 1] if arg == '-x' else arg[2:]
                i += 2 if arg == '-x' else 1
                # The compiler doesn't know cu and hip: their files are passed
                # as rewritten C++ files, each with its own -x
                if value in X_LANGUAGES:
                    x_language = X_LANGUAGES[value]
                    args += ['-x', 'none']
                else:
                    x_language = None if value == 'none' else 'other'
                    args += ['-x', value]
                continue
            if arg in OPTIONS_WITH_VALUE and i + 1 < len(argv):
                args += [arg, argv[i + 1]]
                i += 2
                continue
            language = source_language(arg, x_language)
            if language is not None:
                if work is None:
                    work = work_directory(argv)
                # Keep the file name, so that the default object name stays the same
                out = os.path.join(work, str(i), os.path.basename(arg))
                os.makedirs(os.path.dirname(out))
                status = run([sys.executable, REWRITE, arg, '-o', out, '--language', language,
                              '--shadow-dir', os.path.join(work, str(i), 'headers')], request)
                if status != 0:
                    return status
                args += ['-x', 'c++', out, '-x', 'none']
                rewritten = True
            else:
                args.append(arg)
            i += 1

        front = ['-I' + INCLUDE_DIR]
        if not any(a.startswith('-std=') for a in args):
            front.append('-std=c++23')
        if '-fopenmp' not in args:
            front.append('-fopenmp')
        if rewritten:
            front += ['-include', 'cuda_runtime.h']
        if MODE == 'nvcc':
            major, minor, build = NVCC_VERSION
            front += ['-D__NVCC__', f'-D__CUDACC_VER_MAJOR__={major}', f'-D__CUDACC_VER_MINOR__={minor}',
                      f'-D__CUDACC_VER_BUILD__={build}']

        links = not NO_LINK.intersection(args)
        if MODE == 'nvcc' and links:
            # nvcc links with its host compiler and the CUDA runtime; here,
            # cuda4cpu-c++ with libcuda4cpu (and the toolkit's
            # libcudart_static, which is it), with the same compiler. CMake
            # reads this command in -v's output, and links CUDA programs with
            # the program it starts with.
            return run([HOST_DRIVER] + front + args + ['-L' + os.path.join(TOOLKIT, 'lib64'), '-lcudart_static'],
                       request, env=dict(os.environ, CUDA4CPU_CXX=compiler))

        back = []
        if links:
            back = ['-L' + LIBRARY_DIR, '-Wl,-rpath,' + LIBRARY_DIR, '-lcuda4cpu']

        return run([compiler] + front + args + back, request, env=dict(os.environ, **{RUNNING: '1'}))
    finally:
        if work is not None:
            shutil.rmtree(work, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
