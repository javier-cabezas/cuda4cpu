"""Rewrites the CUDA syntax that C++ can't express into code cuda4cpu compiles.

  kernel<<<grid, block[, shared[, stream]]>>>(args...)
      -> cuda4cpu::launch([&](const auto &...cuda4cpu_args) { kernel(cuda4cpu_args...); },
                          grid, block[, shared[, stream]]).call(args...)

  extern __shared__ T name[];
      -> T *name = cuda4cpu::dynamic_shared<T>();               (in a function)
      -> static cuda4cpu::dynamic_shared_array<T> name;         (at namespace scope)
  extern __shared__ T name[][N];  (and further dimensions)
      -> T (*name)[N] = cuda4cpu::dynamic_shared<T[N]>();
      -> static cuda4cpu::dynamic_shared_array<T[N]> name;
  HIP_DYNAMIC_SHARED(T, name), HIP's macro for that declaration, likewise

  cudaLaunchKernel((void *)kernel, ...), cudaLaunchCooperativeKernel, and
  their HIP names hipLaunchKernel and hipLaunchCooperativeKernel
      -> cudaLaunchKernel(kernel, ...)
      The cast to void * would hide the kernel's parameter types, which
      cuda4cpu needs to unpack the argument array.

  (void *)kernel, for any __global__ function of the file or its local headers
      -> cuda4cpu::kernel_address(kernel)
      Registers the kernel's parameter types under its address, for graph
      kernel nodes (params.func = (void *)kernel) and cudaLaunchKernel.

  clock(), in the body of a __global__ or __device__ function
      -> cuda4cpu::device_clock()
      The device clock counts at the device's clock rate; the C library's
      clock() measures processor time.

  for (...) {, while (...) { and do {, the outermost loops of a __global__
  or __device__ function whose body is a block
      -> for (...) { cuda4cpu::loop_tick();
      Every few iterations, if that makes the kernel faster, the next CUDA
      thread of the block runs: GPU code expects the threads of a warp to
      access neighboring addresses together, and a grid-stride loop run one
      thread after another touches a new page per iteration. Inner loops are
      left alone, so that they still vectorize.

  params.gridDim, params->blockDim
      -> params.cuda4cpu_gridDim, params->cuda4cpu_blockDim
      gridDim and blockDim are macros for the built-in variables, so the fields
      of cudaKernelNodeParams have other names.

  dim3 gridDim, blockDim; (variables, parameters and fields the program declares)
      -> dim3 cuda4cpu_gridDim, cuda4cpu_blockDim;
      Renamed where the declaration is in scope, where it hides the built-in
      variable, as host code that computes a launch's configuration does.

The kernel, the launch configuration and the arguments are copied verbatim, so
the result behaves like the CUDA launch: template arguments are deduced from the
arguments and default arguments apply. Line numbers are preserved and a #line
directive maps diagnostics and __FILE__ to the original file.

Local headers included with #include "..." are rewritten too, into a shadow
directory, and the #include directives point to the rewritten copies. So are
headers that -I names a directory of (#include <...>, or "..." not found
next to the including file), such as a library's with launches in them, but
only those that change or include one that does.

The rewritten .cu file defines __CUDACC__ first, as nvcc does, so that code
that tells CUDA compilation apart from host compilation (for instance the
host fallbacks in the CUDA samples' helper_math.h) takes the CUDA branch.

HIP sources (.hip files, or any file with --language hip) are rewritten the
same way. They also define __HIPCC__ and __HIP_PLATFORM_NVIDIA__, as hipcc
does on HIP's NVIDIA platform, which is how cuda4cpu compiles HIP code,
unless __HIP_PLATFORM_AMD__ is defined (the drivers' AMD platform).
"""

import argparse
import os
import re
import sys

# Prepended to the rewritten file, before its #line directive, by language
PROLOGUES = {
    'cuda': '#ifndef __CUDACC__\n#define __CUDACC__ 1\n#endif\n',
    'hip': '#ifndef __CUDACC__\n#define __CUDACC__ 1\n#endif\n'
           '#ifndef __HIPCC__\n#define __HIPCC__ 1\n#endif\n'
           '#if !defined(__HIP_PLATFORM_NVIDIA__) && !defined(__HIP_PLATFORM_AMD__)\n'
           '#define __HIP_PLATFORM_NVIDIA__ 1\n#endif\n',
}

# Extensions of the files that are HIP sources by default
HIP_EXTENSIONS = ('.hip',)

LAUNCH_PREFIX = 'cuda4cpu::launch([&](const auto &...cuda4cpu_args) { '
LAUNCH_INFIX = '(cuda4cpu_args...); }, '

# Keywords that can't end the expression that names a kernel
KEYWORDS = frozenset('''
    alignas alignof and asm auto bool break case catch char class const constexpr
    const_cast continue decltype default delete do double dynamic_cast else enum
    explicit export extern false float for friend goto if inline int long mutable
    namespace new noexcept not nullptr operator or private protected public
    register reinterpret_cast return short signed sizeof static static_assert
    static_cast struct switch template this throw true try typedef typeid
    typename union unsigned using virtual void volatile while co_await co_return
    co_yield
'''.split())

STRING_PREFIXES = ('u8', 'u', 'U', 'L', '')


LOOP_TICK = ' cuda4cpu::loop_tick();'


class Token:
    __slots__ = ('kind', 'start', 'end', 'text', 'line_start', 'line')

    def __init__(self, kind, start, end, text, line_start):
        self.kind = kind            # 'id', 'number', 'string', 'char', 'punct'
        self.start = start
        self.end = end
        self.text = text
        self.line_start = line_start  # first token on its line
        self.line = 0

    def __repr__(self):
        return f'Token({self.kind!r}, {self.text!r})'


class RewriteError(Exception):
    pass


def lex(text):
    """Splits C++ source into tokens, skipping whitespace and comments."""
    tokens = []
    i, n = 0, len(text)
    line_start = True

    def add(kind, start, end):
        nonlocal line_start
        tokens.append(Token(kind, start, end, text[start:end], line_start))
        line_start = False

    while i < n:
        c = text[i]
        if c == '\n':
            line_start = True
            i += 1
        elif c in ' \t\r\f\v':
            i += 1
        elif c == '\\' and text.startswith('\n', i + 1):
            i += 2                                  # line continuation
        elif text.startswith('//', i):
            while i < n and text[i] != '\n':
                i += 2 if text.startswith('\\\n', i) else 1
        elif text.startswith('/*', i):
            end = text.find('*/', i + 2)
            i = n if end < 0 else end + 2
        elif c.isalpha() or c == '_' or c == '$':
            j = i + 1
            while j < n and (text[j].isalnum() or text[j] in '_$'):
                j += 1
            word = text[i:j]
            if j < n and text[j] == '"' and word.endswith('R') and word[:-1] in STRING_PREFIXES:
                j = skip_raw_string(text, j)
                add('string', i, j)
            elif j < n and text[j] in '"\'' and word in STRING_PREFIXES:
                kind = 'string' if text[j] == '"' else 'char'
                j = skip_quoted(text, j)
                add(kind, i, j)
            else:
                add('id', i, j)
            i = j
        elif c.isdigit() or (c == '.' and i + 1 < n and text[i + 1].isdigit()):
            # pp-number, including digit separators (1'000) and exponents (1e+5)
            j = i + 1
            while j < n:
                if text[j].isalnum() or text[j] in '_.':
                    j += 1
                elif text[j] == "'" and j + 1 < n and text[j + 1].isalnum():
                    j += 2
                elif text[j] in '+-' and text[j - 1] in 'eEpP':
                    j += 1
                else:
                    break
            add('number', i, j)
            i = j
        elif c == '"':
            j = skip_quoted(text, i)
            add('string', i, j)
            i = j
        elif c == "'":
            j = skip_quoted(text, i)
            add('char', i, j)
            i = j
        elif text.startswith('::', i) or text.startswith('->', i):
            add('punct', i, i + 2)
            i += 2
        else:
            add('punct', i, i + 1)
            i += 1
    return tokens


def skip_quoted(text, i):
    """Returns the position after the string or character literal at i."""
    quote = text[i]
    j = i + 1
    while j < len(text):
        if text[j] == '\\':
            j += 2
        elif text[j] == quote:
            return j + 1
        elif text[j] == '\n':
            return j                                # unterminated: stop at the line end
        else:
            j += 1
    return j


def skip_raw_string(text, i):
    """Returns the position after the raw string literal whose quote is at i."""
    paren = text.find('(', i)
    if paren < 0:
        return len(text)
    delimiter = text[i + 1:paren]
    end = text.find(')' + delimiter + '"', paren)
    return len(text) if end < 0 else end + len(delimiter) + 2


def consecutive(tokens, i, count, char):
    """True if tokens[i:i+count] are all `char`. Like nvcc, this accepts spaces
    between them: some CUDA code writes launches as kernel<< <...>> >(...)."""
    if i + count > len(tokens):
        return False
    return all(tokens[k].text == char for k in range(i, i + count))


def match_forward(tokens, i):
    """Index of the bracket that closes tokens[i] ('(', '[' or '{')."""
    pairs = {'(': ')', '[': ']', '{': '}'}
    stack = []
    for k in range(i, len(tokens)):
        t = tokens[k].text
        if t in pairs:
            stack.append(pairs[t])
        elif t in (')', ']', '}'):
            if not stack or stack.pop() != t:
                return None
            if not stack:
                return k
    return None


def match_back(tokens, i):
    """Index of the bracket that opens tokens[i] (')', ']', '}' or '>').

    Angle brackets are matched by counting, skipping anything inside (), []
    and {}, which is how template argument lists nest.
    """
    close = tokens[i].text
    open_ = {')': '(', ']': '[', '}': '{', '>': '<'}[close]
    depth = 0
    k = i
    while k >= 0:
        t = tokens[k].text
        if close == '>' and t in (')', ']', '}'):
            k = match_back(tokens, k)
            if k is None:
                return None
        elif t == close:
            depth += 1
        elif t == open_:
            depth -= 1
            if depth == 0:
                return k
        elif close != '>' and t in (')', ']', '}'):
            pass
        k -= 1
    return None


def kernel_start(tokens, j):
    """Index of the first token of the expression that ends at tokens[j] and
    names the kernel: a possibly qualified name with template arguments, a
    member access, a subscript, a call or a parenthesized expression."""
    k = j
    state = 'primary'
    while k >= 0:
        t = tokens[k]
        if state == 'primary':
            if t.kind == 'id' and t.text not in KEYWORDS:
                k -= 1
                state = 'after'
            elif t.text == '>':
                m = match_back(tokens, k)
                if m is None:
                    return None
                k = m - 1
                state = 'template_name'
            elif t.text == ')':
                m = match_back(tokens, k)
                if m is None:
                    return None
                k = m - 1
                # f(...) is a call; otherwise a parenthesized expression
                if k >= 0 and (tokens[k].kind == 'id' and tokens[k].text not in KEYWORDS or
                               tokens[k].text in (')', ']', '>')):
                    state = 'primary'
                else:
                    state = 'after'
            elif t.text == ']':
                m = match_back(tokens, k)
                if m is None:
                    return None
                k = m - 1
                state = 'primary'
            else:
                return None
        elif state == 'template_name':
            if t.kind == 'id' and t.text not in KEYWORDS:
                k -= 1
                state = 'after'
            else:
                return None
        elif state == 'after':
            if t.text in ('::', '.', '->'):
                if t.text == '::' and (k == 0 or not (tokens[k - 1].kind == 'id' or
                                                      tokens[k - 1].text in ('>', ')', ']'))):
                    return k                        # leading :: (global namespace)
                k -= 1
                state = 'primary'
            elif t.kind == 'id' and t.text == 'template' and k > 0 and tokens[k - 1].text in ('::', '.', '->'):
                k -= 1                              # x.template f<T>
            else:
                break
    return k + 1


def find_launches(tokens):
    """Returns (start, lt, gt, open_paren, close_paren) token indices for every
    kernel launch: tokens[start:lt] name the kernel, tokens[lt+3:gt] are the
    configuration and tokens[open_paren+1:close_paren] the arguments."""
    launches = []
    i = 0
    while i < len(tokens):
        if tokens[i].text == '<' and consecutive(tokens, i, 3, '<') and i > 0 and \
                tokens[i - 1].text not in ('operator', '<'):
            start = kernel_start(tokens, i - 1)
            gt = config_end(tokens, i + 3)
            if start is not None and start < i and gt is not None and \
                    gt + 3 < len(tokens) and tokens[gt + 3].text == '(':
                close = match_forward(tokens, gt + 3)
                if close is not None:
                    launches.append((start, i, gt, gt + 3, close))
                    i += 3
                    continue
            raise RewriteError(line_of(tokens[i]), 'could not parse the kernel launch')
        i += 1
    return launches


def config_end(tokens, i):
    """Index of the first of the three '>' that end a launch configuration."""
    depth = 0
    for k in range(i, len(tokens)):
        t = tokens[k].text
        if t in '([{':
            depth += 1
        elif t in ')]}':
            depth -= 1
            if depth < 0:
                return None
        elif t == '>' and depth == 0 and consecutive(tokens, k, 3, '>'):
            return k
        elif t == ';' and depth == 0:
            return None
    return None


def find_extern_shared(tokens):
    """Returns (first, last, type_tokens, name, namespace_scope, dimensions)
    for every `extern __shared__ T name[];` declaration, and every
    HIP_DYNAMIC_SHARED(T, name), whose last token is its ')'. dimensions are
    the tokens of the bounds after the first, `[N][M]` in `name[][N][M]`."""
    found = []
    scopes = []                                     # True for namespace scopes
    for i, t in enumerate(tokens):
        if t.text == '{':
            scopes.append(opens_namespace(tokens, i))
        elif t.text == '}':
            if scopes:
                scopes.pop()
        elif t.text == 'HIP_DYNAMIC_SHARED' and i + 1 < len(tokens) and tokens[i + 1].text == '(' and \
                (i == 0 or tokens[i - 1].text != 'define'):
            close = match_forward(tokens, i + 1)
            # The name follows the last comma: the type may contain commas
            if close is None or close - i < 5 or tokens[close - 2].text != ',' or \
                    tokens[close - 1].kind != 'id':
                raise RewriteError(line_of(t), 'unsupported HIP_DYNAMIC_SHARED declaration')
            found.append((i, close, tokens[i + 2:close - 2], tokens[close - 1].text, all(scopes), []))
        elif t.text == 'extern' and i + 1 < len(tokens) and tokens[i + 1].kind != 'string':
            semi = i
            while semi < len(tokens) and tokens[semi].text not in (';', '{', '}'):
                semi += 1
            if semi >= len(tokens) or tokens[semi].text != ';':
                continue
            decl = tokens[i + 1:semi]
            if not any(d.text == '__shared__' for d in decl):
                continue
            # The bounds after the first, each a bracketed expression
            dims_start = len(decl)
            while dims_start > 0 and decl[dims_start - 1].text == ']':
                depth, k = 0, dims_start - 1
                while k >= 0:
                    depth += {']': 1, '[': -1}.get(decl[k].text, 0)
                    if depth == 0:
                        break
                    k -= 1
                if k < 0 or k == dims_start - 2:
                    break
                dims_start = k
            dimensions = decl[dims_start:]
            decl = decl[:dims_start]
            if len(decl) < 4 or decl[-1].text != ']' or decl[-2].text != '[' or decl[-3].kind != 'id':
                raise RewriteError(line_of(t), 'unsupported extern __shared__ declaration')
            # The type is what remains without __shared__ and alignment specifiers
            type_tokens = []
            k = 0
            body = decl[:-3]
            while k < len(body):
                d = body[k]
                if d.text == '__shared__':
                    k += 1
                elif d.text in ('__align__', 'alignas') and k + 1 < len(body) and body[k + 1].text == '(':
                    close = k + 1
                    depth = 0
                    while close < len(body):
                        depth += {'(': 1, ')': -1}.get(body[close].text, 0)
                        if depth == 0:
                            break
                        close += 1
                    k = close + 1
                else:
                    type_tokens.append(d)
                    k += 1
            if not type_tokens:
                raise RewriteError(line_of(t), 'extern __shared__ declaration without a type')
            found.append((i, semi, type_tokens, decl[-3].text, all(scopes), dimensions))
    return found


# Launch functions whose kernel argument is commonly cast to void *
LAUNCH_FUNCTIONS = frozenset(('cudaLaunchKernel', 'cudaLaunchCooperativeKernel',
                              'hipLaunchKernel', 'hipLaunchCooperativeKernel'))


def find_void_casts(tokens):
    """Yields (first, last) token indices of each cast to void * of the
    first argument of a launch function: (void *), (const void *) or
    reinterpret_cast<void *>, with the parenthesis of a reinterpret_cast left
    in place."""
    for i, t in enumerate(tokens):
        if t.kind != 'id' or t.text not in LAUNCH_FUNCTIONS or i + 1 >= len(tokens) or \
                tokens[i + 1].text != '(' or (i > 0 and tokens[i - 1].text in ('.', '->')):
            continue
        k = i + 2
        texts = [u.text for u in tokens[k:k + 7]]
        for form in (['(', 'void', '*', ')'], ['(', 'const', 'void', '*', ')'],
                     ['reinterpret_cast', '<', 'void', '*', '>'],
                     ['reinterpret_cast', '<', 'const', 'void', '*', '>']):
            if texts[:len(form)] == form:
                yield k, k + len(form) - 1
                break


# Casts to void *, as token texts; the operand follows
VOID_CASTS = (['(', 'void', '*', ')'], ['(', 'const', 'void', '*', ')'])
VOID_REINTERPRET_CASTS = (['reinterpret_cast', '<', 'void', '*', '>', '('],
                          ['reinterpret_cast', '<', 'const', 'void', '*', '>', '('])

# Words that can come between __global__ and the kernel's name
DECLARATION_WORDS = frozenset(('void', 'static', 'inline', 'extern', '__forceinline__', '__noinline__',
                               '__host__', '__device__', 'constexpr'))


def find_kernels(tokens):
    """Yields the names of the __global__ functions declared in tokens."""
    for i, t in enumerate(tokens):
        if t.text != '__global__':
            continue
        k = i + 1
        while k < len(tokens):
            u = tokens[k]
            if u.text in ('__launch_bounds__', '__attribute__', 'alignas') and \
                    k + 1 < len(tokens) and tokens[k + 1].text == '(':
                close = match_forward(tokens, k + 1)    # skip its arguments
                if close is None:
                    break
                k = close + 1
            elif u.kind == 'id' and u.text in DECLARATION_WORDS or u.kind == 'string':
                k += 1
            elif u.kind == 'id' and k + 1 < len(tokens) and tokens[k + 1].text in ('(', '<'):
                yield u.text
                break
            else:
                break


def kernel_operand(tokens, k, kernels):
    """If tokens[k:] is a kernel name (with an optional &, qualification and
    template arguments), returns the index of its last token."""
    if k < len(tokens) and tokens[k].text == '&':
        k += 1
    while k + 2 < len(tokens) and tokens[k].kind == 'id' and tokens[k + 1].text == '::':
        k += 2
    if k >= len(tokens) or tokens[k].kind != 'id' or tokens[k].text not in kernels:
        return None
    if k + 1 < len(tokens) and tokens[k + 1].text == '<':
        depth = 0
        for j in range(k + 1, len(tokens)):
            if tokens[j].text == '<':
                depth += 1
            elif tokens[j].text == '>':
                depth -= 1
                if depth == 0:
                    return j
            elif tokens[j].text == '>>':
                depth -= 2
                if depth <= 0:
                    return j
            elif tokens[j].text in (';', '{', '}'):
                return None
        return None
    return k


def find_kernel_casts(tokens, kernels, skip):
    """Yields (first, last, operand_first, operand_last) for each cast of a
    kernel to void *, except the casts starting at the indices in skip."""
    for i in range(len(tokens)):
        if i in skip:
            continue
        texts = [u.text for u in tokens[i:i + 7]]
        for form in VOID_CASTS:
            if texts[:len(form)] == form:
                last = kernel_operand(tokens, i + len(form), kernels)
                if last is not None:
                    yield i, last, i + len(form), last
                break
        else:
            for form in VOID_REINTERPRET_CASTS:
                if texts[:len(form)] == form:
                    last = kernel_operand(tokens, i + len(form), kernels)
                    if last is not None and last + 1 < len(tokens) and tokens[last + 1].text == ')':
                        yield i, last + 1, i + len(form), last
                    break


def device_bodies(tokens):
    """Yields (open, close) token indices of the bodies of the __global__ and
    __device__ functions in tokens."""
    i = 0
    while i < len(tokens):
        if tokens[i].text not in ('__global__', '__device__'):
            i += 1
            continue
        # The body is the first '{' outside parentheses, before any ';' or '='
        # (which make it a variable)
        k = i + 1
        while k < len(tokens) and tokens[k].text not in ('{', ';', '='):
            if tokens[k].text in ('(', '['):
                close = match_forward(tokens, k)
                if close is None:
                    break
                k = close
            k += 1
        if k < len(tokens) and tokens[k].text == '{':
            close = match_forward(tokens, k)
            if close is not None:
                yield k, close
                i = close + 1
                continue
        i = k + 1


def find_device_clocks(tokens):
    """Yields the indices of calls to clock() in device functions."""
    for open_, close in device_bodies(tokens):
        for k in range(open_ + 1, close - 2):
            if tokens[k].text == 'clock' and tokens[k + 1].text == '(' and tokens[k + 2].text == ')' and \
                    tokens[k - 1].text not in ('.', '->', '::'):
                yield k


def statement_end(tokens, k, limit):
    """Returns the index of the last token of the statement that starts at
    token k, before limit: up to a ';' or a block outside parentheses,
    including an else branch."""
    while k < limit:
        t = tokens[k].text
        if t in ('(', '['):
            close = match_forward(tokens, k)
            if close is None:
                return limit - 1
            k = close
        elif t == '{':
            close = match_forward(tokens, k)
            if close is None:
                return limit - 1
            if close + 1 < limit and tokens[close + 1].text == 'else':
                k = close + 1
            else:
                return close
        elif t == ';':
            if k + 1 < limit and tokens[k + 1].text == 'else':
                k += 1
            else:
                return k
        k += 1
    return limit - 1


def find_loop_bodies(tokens):
    """Yields the index of the '{' that opens the body of each outermost loop
    (for, while, do) in the __global__ and __device__ functions of tokens.
    Loops inside them are skipped, and so are loops whose body isn't a block."""
    for open_, close in device_bodies(tokens):
        k = open_ + 1
        while k < close:
            t = tokens[k].text
            if tokens[k - 1].text in ('.', '->', '::'):
                k += 1
            elif t in ('for', 'while') and tokens[k + 1].text == '(':
                paren = match_forward(tokens, k + 1)
                if paren is None or paren + 1 >= close:
                    k += 1
                    continue
                body = paren + 1
                if t == 'while' and tokens[body].text == ';':          # the end of a do-while
                    k = body + 1
                elif tokens[body].text == '{':
                    yield body
                    k = (match_forward(tokens, body) or body) + 1
                else:
                    k = statement_end(tokens, body, close) + 1
            elif t == 'do':
                if tokens[k + 1].text == '{':
                    yield k + 1
                    k = (match_forward(tokens, k + 1) or k + 1) + 1
                else:
                    k = statement_end(tokens, k + 1, close) + 1
            else:
                k += 1


def find_dim_fields(tokens):
    """Yields the indices of gridDim and blockDim used as member names:
    after . or ->, or qualified by a class (fragment<T>::blockDim(), as
    rocWMMA's member functions defined outside their class), not by a
    leading ::."""
    for i in range(1, len(tokens)):
        if tokens[i].text not in ('gridDim', 'blockDim'):
            continue
        before = tokens[i - 1].text
        if before in ('.', '->') or \
                (before == '::' and i >= 2 and (tokens[i - 2].kind == 'id' or tokens[i - 2].text == '>')):
            yield i


# Words after which gridDim or blockDim is an expression, not a declaration
EXPRESSION_WORDS = frozenset(('return', 'case', 'sizeof', 'throw', 'co_return', 'co_yield', 'co_await', 'else',
                              'do', 'delete', 'new', 'typeid', 'alignof', 'goto', 'not', 'and', 'or', 'xor',
                              'bitand', 'bitor', 'compl', 'not_eq', 'and_eq', 'or_eq', 'xor_eq',
                              'define', 'undef', 'ifdef', 'ifndef', 'defined'))

# Tokens that can follow a declared name: an initializer, the next declarator,
# the end of a parameter list, an array bound, a range-for's colon
DECLARATOR_ENDS = (';', '=', '(', '{', ',', '[', ')', ':')


def find_dim_variables(tokens):
    """Yields the indices of gridDim and blockDim where they name a variable,
    parameter or field that the program declares (`dim3 gridDim;`): in the
    declaration's scope, from it to the end of its block, or for a parameter,
    the function's body or the statement of a for, if, while or switch.
    Declarations at namespace scope are left alone, and so are uses of a field
    outside its class's braces (in member functions defined out of line)."""
    enclosing, stack, match = [], [], {}
    for i, t in enumerate(tokens):
        enclosing.append(stack[-1] if stack else None)
        if t.text in ('(', '[', '{'):
            stack.append(i)
        elif t.text in (')', ']', '}') and stack:
            match[stack.pop()] = i
    last = len(tokens) - 1

    def after_type(i):
        """Whether tokens[i] follows a type: dim3 x, const dim3 &x, dim3 *x,
        std::vector<dim3> x. No expression puts a name there."""
        k = i - 1
        while k > 0 and tokens[k].text in ('*', '&', '&&'):
            k -= 1
        return (tokens[k].kind == 'id' and tokens[k].text not in EXPRESSION_WORDS) or \
            tokens[k].text in ('>', '>>')

    def later_declarator(i, opener):
        """Whether the comma before tokens[i] separates the declarators of a
        declaration statement: dim3 threads(64), blockDim(32);"""
        if tokens[i - 1].text != ',' or tokens[opener].text != '{':
            return False
        j, depth = i - 2, 0
        while j > opener:
            t = tokens[j].text
            if t in (')', ']', '}'):
                if depth == 0 and t == '}':
                    break
                depth += 1
            elif t in ('(', '[', '{'):
                depth -= 1
            elif t == ';' and depth == 0:
                break
            j -= 1
        first = j + 1
        return first + 1 < i and tokens[first].kind == 'id' and tokens[first].text not in EXPRESSION_WORDS and \
            (tokens[first + 1].kind == 'id' or tokens[first + 1].text in ('::', '<'))

    def statement_end(k):
        """The last token of the statement that starts at tokens[k]"""
        if tokens[k].text == '{':
            return match.get(k, last)
        while k < last and tokens[k].text != ';':
            if tokens[k].text in ('(', '[', '{'):
                k = match.get(k, last)
            k += 1
        return k

    def function_body(close):
        """The '{' of the body of the function whose parameters close at
        tokens[close], past qualifiers and a constructor's initializers, or
        None for a declaration"""
        k = close + 1
        if k <= last and tokens[k].text == ':':
            # Initializers: member(...) or member{...}, separated by commas
            k += 1
            while k <= last:
                while k <= last and tokens[k].text not in ('(', '{', ';'):
                    k += 1
                if k > last or tokens[k].text == ';':
                    return None
                k = match.get(k, last) + 1
                if k <= last and tokens[k].text == ',':
                    k += 1
                    continue
                break
            return k if k <= last and tokens[k].text == '{' else None
        while k <= last and tokens[k].text not in ('{', ';'):
            if tokens[k].text in ('(', '['):
                k = match.get(k, last)
            k += 1
        return k if k <= last and tokens[k].text == '{' else None

    renamed = set()
    for i in range(1, len(tokens) - 1):
        name = tokens[i].text
        if name not in ('gridDim', 'blockDim') or tokens[i + 1].text not in DECLARATOR_ENDS:
            continue
        opener = enclosing[i]
        if opener is None or not (after_type(i) or later_declarator(i, opener)):
            continue
        if tokens[opener].text == '(':
            close = match.get(opener, last)
            if opener > 0 and tokens[opener - 1].text in ('for', 'if', 'while', 'switch'):
                end = statement_end(close + 1) if close < last else close
            else:
                # A parameter: its scope is the body that follows, if any
                body = function_body(close)
                end = match.get(body, last) if body is not None else close
        elif tokens[opener].text == '{' and not opens_namespace(tokens, opener):
            end = match.get(opener, last)
        else:
            continue
        declared = {name}
        if tokens[opener].text == '{':
            # The declaration's other declarators: dim3 gridDim, blockDim;
            k = i + 1
            while k < end and tokens[k].text != ';':
                if tokens[k].text == ',' and enclosing[k] == opener and tokens[k + 1].text in ('gridDim', 'blockDim'):
                    declared.add(tokens[k + 1].text)
                k += 1
        for k in range(i, end + 1):
            if tokens[k].text in declared and tokens[k - 1].text not in ('.', '->', '::'):
                renamed.add(k)
    yield from sorted(renamed)


def opens_namespace(tokens, i):
    """True if the '{' at tokens[i] opens a namespace or an extern "C" block."""
    k = i - 1
    while k >= 0 and (tokens[k].kind == 'id' or tokens[k].text == '::'):
        if tokens[k].text == 'namespace':
            return True
        k -= 1
    return k >= 1 and tokens[k].kind == 'string' and tokens[k - 1].text == 'extern'


def line_of(token):
    return token.line


class Rewriter:
    def __init__(self, shadow_dir, include_dirs=()):
        self.shadow_dir = shadow_dir
        self.include_dirs = [os.path.abspath(d) for d in include_dirs]
        self.read_files = []                        # every file read, for depfiles
        self.done = {}                              # original path -> shadow path, or None
        self.kernels = set()                        # __global__ functions seen so far
        self.in_progress = set()                    # headers being rewritten
        self.cycled = set()                         # ... that their own includes point to
        self.library = set()                        # headers of include directories, and theirs

    def shadow_path(self, path):
        return os.path.join(self.shadow_dir, path.lstrip(os.sep))

    def rewrite_file(self, path):
        """Rewrites path and the headers it includes; returns the text."""
        return self.rewrite(path)[0]

    def rewrite(self, path):
        """The rewritten text of path, and whether it differs from the file
        (other than the #line directive that starts it)"""
        path = os.path.abspath(path)
        self.read_files.append(path)
        with open(path, encoding='utf-8', errors='surrogateescape') as f:
            text = f.read()
        redirects = {}                              # relative include -> its original path
        try:
            result = rewrite_text(text, path, self.include_hook(path, redirects), self.kernels)
        except RewriteError as e:
            line, message = e.args
            raise RewriteError(line, f'{path}:{line}: error: {message}') from None
        # A header found next to this one isn't next to a rewritten copy, but
        # pointing to it isn't a change: an unchanged copy isn't written
        changed = result.split('\n', 1)[1] != text
        for name, header in redirects.items():
            result = re.sub(r'^([ \t]*#[ \t]*include[ \t]*)"' + re.escape(name) + '"',
                            lambda m: m.group(1) + quote(header), result, flags=re.M)
        return result, changed

    def find_header(self, directory, name, angled):
        """The header that #include names, and whether it is local: next to
        the including file, for a quote include, else in an include
        directory. None if it is neither, as system headers are."""
        if not angled:
            local = os.path.normpath(os.path.join(directory, name))
            if os.path.isfile(local):
                return local, True
        for include_dir in self.include_dirs:
            header = os.path.normpath(os.path.join(include_dir, name))
            if os.path.isfile(header):
                return header, False
        return None, False

    def include_hook(self, path, redirects):
        directory = os.path.dirname(path)
        from_library = path in self.library

        def hook(name, angled=False):
            header, local = self.find_header(directory, name, angled)
            if header is None:
                return None
            # A library's own headers, found next to its others, are its too
            relative = local
            local = local and not from_library
            if not local and header not in self.done:
                self.library.add(header)
            if header in self.done:
                if header in self.in_progress:
                    self.cycled.add(header)
            else:
                self.done[header] = self.rewrite_header(header, local)
            if self.done[header] is None and relative:
                redirects[name] = header
            return self.done[header]
        return hook

    def rewrite_header(self, header, local):
        """The path of header's rewritten copy, or None if it isn't needed"""
        shadow = self.shadow_path(header)
        self.done[header] = shadow
        self.in_progress.add(header)
        text, changed = self.rewrite(header)
        self.in_progress.discard(header)
        # A header from an include directory is rewritten only if it, or
        # a header it includes, changes: libraries stay where they are,
        # and so do headers with #pragma once that others include too
        if local or changed or header in self.cycled:
            write_if_changed(shadow, text)
            return shadow
        return None


def rewrite_text(text, path, include_hook=None, kernels=None):
    """Rewrites the CUDA syntax of text, which comes from path. kernels is the
    set of __global__ functions known so far, to which this file's are added."""
    tokens = lex(text)
    kernels = set() if kernels is None else kernels
    kernels.update(find_kernels(tokens))
    line, pos = 1, 0
    for t in tokens:
        line += text.count('\n', pos, t.start)
        pos = t.start
        t.line = line

    replacements = []                               # (start, end, new text)

    if include_hook is not None:
        for i, t in enumerate(tokens):
            if not (t.text == '#' and t.line_start and i + 2 < len(tokens) and tokens[i + 1].text == 'include'):
                continue
            name_token = tokens[i + 2]
            if name_token.kind == 'string' and name_token.text.startswith('"'):
                target = include_hook(name_token.text[1:-1])
                if target is not None:
                    replacements.append((name_token.start, name_token.end, quote(target)))
            elif name_token.text == '<':
                # <name>, up to the > on the same line
                line_end = text.find('\n', name_token.end)
                end = text.find('>', name_token.end, line_end if line_end >= 0 else len(text))
                if end > name_token.end:
                    target = include_hook(text[name_token.end:end], angled=True)
                    if target is not None:
                        replacements.append((name_token.start, end + 1, quote(target)))

    for first, semi, type_tokens, name, namespace_scope, dimensions in find_extern_shared(tokens):
        type_text = ' '.join(source(text, type_tokens[0], type_tokens[-1]).split())
        dims = ' '.join(source(text, dimensions[0], dimensions[-1]).split()) if dimensions else ''
        if namespace_scope:
            new = f'static cuda4cpu::dynamic_shared_array<{type_text}{dims}> {name};'
        elif dims:
            new = f'{type_text} (*{name}){dims} = cuda4cpu::dynamic_shared<{type_text}{dims}>();'
        else:
            new = f'{type_text} *{name} = cuda4cpu::dynamic_shared<{type_text}>();'
        # Keep the newlines the declaration may span, so that line numbers don't change
        newlines = text.count('\n', tokens[first].start, tokens[semi].end)
        replacements.append((tokens[first].start, tokens[semi].end, new + '\n' * newlines))

    launch_casts = set()
    for first, last in find_void_casts(tokens):
        # Keep the newlines the cast may span, so that line numbers don't change
        replacements.append((tokens[first].start, tokens[last].end,
                             '\n' * text.count('\n', tokens[first].start, tokens[last].end)))
        launch_casts.add(first)

    # Kernels are known once the includes above have been rewritten
    for first, last, op_first, op_last in find_kernel_casts(tokens, kernels, launch_casts):
        operand = text[tokens[op_first].start:tokens[op_last].end]
        newlines = text.count('\n', tokens[first].start, tokens[op_first].start) + \
            text.count('\n', tokens[op_last].end, tokens[last].end)
        replacements.append((tokens[first].start, tokens[last].end,
                             f'cuda4cpu::kernel_address({operand}){chr(10) * newlines}'))

    for i in find_device_clocks(tokens):
        replacements.append((tokens[i].start, tokens[i].end, 'cuda4cpu::device_clock'))

    for i in find_dim_fields(tokens):
        replacements.append((tokens[i].start, tokens[i].end, 'cuda4cpu_' + tokens[i].text))

    for i in find_dim_variables(tokens):
        replacements.append((tokens[i].start, tokens[i].end, 'cuda4cpu_' + tokens[i].text))

    for i in find_loop_bodies(tokens):
        replacements.append((tokens[i].end, tokens[i].end, LOOP_TICK))

    replacements.sort()
    launches = find_launches(tokens)                # sorted by position

    def render(begin, end):
        """text[begin:end] with the launches and replacements inside it. A
        launch nested in another one's arguments is skipped here and rendered
        by the recursive call for those arguments."""
        out = []
        pos = begin
        for start, lt, gt, open_, close in launches:
            s, e = tokens[start].start, tokens[close].end
            if s < pos or e > end:
                continue
            out.append(render_plain(pos, s))
            kernel = text[tokens[start].start:tokens[lt - 1].end]
            config = render(tokens[lt + 2].end, tokens[gt].start)
            args = render(tokens[open_].end, tokens[close].start)
            out.append(f'{LAUNCH_PREFIX}{kernel}{LAUNCH_INFIX}{config}).call({args})')
            pos = e
        out.append(render_plain(pos, end))
        return ''.join(out)

    def render_plain(begin, end):
        out = []
        pos = begin
        for s, e, new in replacements:
            if s >= begin and e <= end:
                out.append(text[pos:s])
                out.append(new)
                pos = e
        out.append(text[pos:end])
        return ''.join(out)

    return f'#line 1 {quote(path)}\n{render(0, len(text))}'


def quote(path):
    return '"' + path.replace('\\', '\\\\').replace('"', '\\"') + '"'


def source(text, first, last):
    return text[first.start:last.end]


def write_if_changed(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path, encoding='utf-8', errors='surrogateescape') as f:
            if f.read() == content:
                return
    except OSError:
        pass
    with open(path, 'w', encoding='utf-8', errors='surrogateescape') as f:
        f.write(content)


def write_depfile(path, target, dependencies):
    def escape(p):
        return p.replace('\\', '\\\\').replace(' ', '\\ ').replace('#', '\\#').replace('$', '$$')
    with open(path, 'w') as f:
        f.write(escape(target) + ': ' + ' \\\n  '.join(escape(d) for d in dependencies) + '\n')


def main(argv=None):
    parser = argparse.ArgumentParser(
        description='Rewrites CUDA launches (kernel<<<...>>>(...)) and extern __shared__ '
                    'declarations so that cuda4cpu can compile a .cu or .hip file.')
    parser.add_argument('input', help='CUDA or HIP source file')
    parser.add_argument('-o', '--output', help='rewritten file (default: standard output)')
    parser.add_argument('--shadow-dir',
                        help='directory for the rewritten local headers (default: OUTPUT.headers)')
    parser.add_argument('--depfile', help='write a Makefile-style dependency file')
    parser.add_argument('-I', '--include-dir', action='append', default=[], dest='include_dirs',
                        help='a directory to look for included headers in, as the compiler does: '
                             'those that need rewriting are rewritten into the shadow directory')
    parser.add_argument('--language', choices=sorted(PROLOGUES),
                        help='language of the input: hip for .hip files, cuda otherwise (default)')
    args = parser.parse_args(argv)

    if args.language is None:
        args.language = 'hip' if args.input.endswith(HIP_EXTENSIONS) else 'cuda'

    if args.shadow_dir is None:
        if args.output is None:
            parser.error('--shadow-dir is required when writing to standard output')
        args.shadow_dir = args.output + '.headers'

    rewriter = Rewriter(os.path.abspath(args.shadow_dir), args.include_dirs)
    try:
        result = rewriter.rewrite_file(args.input)
    except RewriteError as e:
        print(f'cuda4cpu-rewrite: {e.args[1]}', file=sys.stderr)
        return 1
    except OSError as e:
        print(f'cuda4cpu-rewrite: {e}', file=sys.stderr)
        return 1

    result = PROLOGUES[args.language] + result
    if args.output is None:
        sys.stdout.write(result)
    else:
        write_if_changed(os.path.abspath(args.output), result)
    if args.depfile:
        write_depfile(args.depfile, args.output or '-', rewriter.read_files)
    return 0


if __name__ == '__main__':
    sys.exit(main())
