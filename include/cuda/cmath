// libcu++'s <cuda/cmath>: integer division rounded up, and rounding to a
// multiple
#pragma once

#include <type_traits>

namespace cuda {

//! a / b rounded up, for a >= 0 and b > 0
template <typename T, typename U>
    requires(::std::is_integral_v<T> && ::std::is_integral_v<U>)
constexpr ::std::common_type_t<T, U> ceil_div(const T a, const U b)
{
    using R = ::std::common_type_t<T, U>;
    return R(R(a) / R(b) + R(R(a) % R(b) != 0));
}

//! The smallest multiple of b not below a
template <typename T, typename U>
    requires(::std::is_integral_v<T> && ::std::is_integral_v<U>)
constexpr ::std::common_type_t<T, U> round_up(const T a, const U b)
{
    using R = ::std::common_type_t<T, U>;
    return R(ceil_div(a, b) * R(b));
}

//! The largest multiple of b not above a
template <typename T, typename U>
    requires(::std::is_integral_v<T> && ::std::is_integral_v<U>)
constexpr ::std::common_type_t<T, U> round_down(const T a, const U b)
{
    using R = ::std::common_type_t<T, U>;
    return R(R(a) / R(b) * R(b));
}

}
