    "rodinia": {
      "url": "https://github.com/yuhc/gpu-rodinia.git",
      "revision": "9c10d3ea16ddba2ba057cc3951a9efc4c2cc18a4",
      "description": "Rodinia benchmarks that generate their inputs (the others need Rodinia's separate data download). Except lud -v, they don't check their results: passing means they run to completion.",
      "defaults": {
        "verified": false,
        "cflags": [
          "-std=gnu89"
        ]
      },
      "programs": [
        {
          "dir": "cuda/backprop",
          "sources": [
            "backprop.c",
            "facetrain.c",
            "imagenet.c",
            "backprop_cuda.cu"
          ],
          "args": [
            "65536"
          ]
        },
        {
          "dir": "cuda/gaussian",
          "sources": [
            "gaussian.cu"
          ],
          "args": [
            "-s",
            "512"
          ]
        },
        {
          "dir": "cuda/lavaMD",
          "sources": [
            "main.c",
            "kernel/kernel_gpu_cuda_wrapper.cu",
            "util/num/num.c",
            "util/timer/timer.c",
            "util/device/device.cu"
          ],
          "args": [
            "-boxes1d",
            "10"
          ]
        },
        {
          "dir": "cuda/lud",
          "name": "lud",
          "sources": [
            "cuda/lud.cu",
            "cuda/lud_kernel.cu",
            "common/common.c"
          ],
          "include": [
            "cuda/lud/common"
          ],
          "args": [
            "-s",
            "256",
            "-v"
          ],
          "verified": true,
          "reject": "dismatch"
        },
        {
          "dir": "cuda/nw",
          "name": "needle",
          "sources": [
            "needle.cu"
          ],
          "args": [
            "2048",
            "10"
          ]
        },
        {
          "dir": "cuda/pathfinder",
          "sources": [
            "pathfinder.cu"
          ],
          "args": [
            "100000",
            "100",
            "20"
          ]
        },
        {
          "dir": "cuda/srad/srad_v2",
          "name": "srad_v2",
          "sources": [
            "srad.cu"
          ],
          "args": [
            "2048",
            "2048",
            "0",
            "127",
            "0",
            "127",
            "0.5",
            "2"
          ]
        },
        {
          "dir": "cuda/streamcluster",
          "sources": [
            "streamcluster_cuda_cpu.cpp",
            "streamcluster_cuda.cu",
            "streamcluster_header.cu"
          ],
          "args": [
            "10",
            "20",
            "256",
            "65536",
            "65536",
            "1000",
            "none",
            "output.txt",
            "1"
          ]
        },
        {
          "dir": "cuda/hybridsort",
          "sources": [
            "bucketsort.cu",
            "mergesort.cu",
            "main.cu"
          ],
          "args": [
            "r"
          ]
        },
        {
          "dir": "cuda/particlefilter",
          "name": "particlefilter_naive",
          "sources": [
            "ex_particle_CUDA_naive_seq.cu"
          ],
          "args": [
            "-x",
            "128",
            "-y",
            "128",
            "-z",
            "10",
            "-np",
            "1000"
          ]
        },
        {
          "dir": "cuda/particlefilter",
          "name": "particlefilter_float",
          "sources": [
            "ex_particle_CUDA_float_seq.cu"
          ],
          "args": [
            "-x",
            "128",
            "-y",
            "128",
            "-z",
            "10",
            "-np",
            "1000"
          ]
        }
      ]
