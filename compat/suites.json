      "url": "https://github.com/NVIDIA/cuda-samples.git",
      "revision": "v13.4",
      "description": "NVIDIA's CUDA samples that use only the runtime API and the kernel language (no graphics interop, driver API, NVRTC, CUDA libraries, Thrust/CUB, MPI or multiple GPUs). They check their own results.",
      "defaults": {
